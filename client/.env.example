# Client Environment Variables
# Copy this file to .env and fill in the values

# The base URL of the TaskFlow Backend API
# Default local dev is usually http://localhost:5000/api/v1
# For production, can be left blank if hosted on same domain, or set to production API URL
VITE_API_URL=http://localhost:5000/api/v1

# Used for Google Login integration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
