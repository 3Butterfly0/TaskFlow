# Server Environment Variables
# Copy this file to .env and fill in the values

# Databse connection
MONGO_URI=mongodb://localhost:27017/taskflow

# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
# Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` to generate a secure secret
JWT_SECRET=your_jwt_secret_here

# Optional: Cloudinary Configuration (For user avatars and task attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: SMTP Configuration (For email invitations)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: Google OAuth Configuration (For "Continue with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
